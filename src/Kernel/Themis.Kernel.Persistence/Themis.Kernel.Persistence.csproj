    Kernel capabilities reach each other through Themis.Kernel.Contracts (ARCH-08); no public types (ARCH-07).
  -->

  <ItemGroup>
    <ProjectReference Include="../Themis.Kernel.Primitives/Themis.Kernel.Primitives.csproj" />
    <ProjectReference Include="../Themis.Kernel.Contracts/Themis.Kernel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Themis.Host" />
    <InternalsVisibleTo Include="Themis.Migrator" />
    <InternalsVisibleTo Include="Themis.Architecture.Tests" />
    <InternalsVisibleTo Include="Themis.Kernel.Tests" />
    <InternalsVisibleTo Include="Themis.Integration.Tests" />
    <InternalsVisibleTo Include="Themis.Invariants.Tests" />
  </ItemGroup>

</Project>
