    Infrastructure (ARCH-05).
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Themis.Kernel.Contracts/Themis.Kernel.Contracts.csproj" />
    <ProjectReference Include="../Themis.Kernel.Application/Themis.Kernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Themis.ArchitectureTests" />
    <InternalsVisibleTo Include="Themis.UnitTests" />
    <InternalsVisibleTo Include="Themis.Host" />
  </ItemGroup>

</Project>
