<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Themis.Migrator: the only process that applies migrations, connected as themis_migrator (brief, Database model).
    Wiring only (ARCH-03): it verifies the connection and the role, then applies the pending migrations of the kernel
    data context in Themis.Kernel.Persistence. The application never calls Migrate().
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kernel/Themis.Kernel.Persistence/Themis.Kernel.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
