{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Themis": ""
  },
  "Identity": {
    "Authority": "",
    "Audience": "themis-api",
    "RequireHttpsMetadata": true
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "PollInterval": "00:00:01",
      "BatchSize": 100
    }
  },
  "Idempotency": {
    "Purge": {
      "Enabled": true,
      "Interval": "00:05:00",
      "BatchSize": 1000
    }
  }
}
