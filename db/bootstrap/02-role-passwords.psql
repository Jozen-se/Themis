-- Themis database bootstrap, part 2: the passwords of the three LOGIN roles that 01-roles.sql creates (RR-65).
--
-- psql only. The passwords come from the psql variables themis_migrator_password, themis_app_password and
-- themis_reporting_password, never from this file or the repository (Build Brief, Secrets). Set them with \set or
-- \getenv before this script runs, or with -v on the command line; the compose stack sets them through \getenv in
-- docker/postgres/initdb/10-themis-bootstrap.sh, so they do not show in the process list. A real installation supplies
-- its own values the same way, outside the coder's work.
--
-- Run as a superuser after 01-roles.sql, with ON_ERROR_STOP:
--   psql -v ON_ERROR_STOP=1 -v themis_migrator_password=... -v themis_app_password=... \
--        -v themis_reporting_password=... -f db/bootstrap/02-role-passwords.psql
-- The script checks every variable first and stops with a non-zero exit code naming the first one that is missing,
-- before any password changes (the DO block only raises that error). Each ALTER ROLE runs outside a DO block, with
-- the value quoted by format('%L') and executed by \gexec.

\set ON_ERROR_STOP on

\if :{?themis_migrator_password}
\else
    DO $$ BEGIN RAISE EXCEPTION 'The psql variable themis_migrator_password is not set; no password was changed (RR-65).'; END $$;
\endif

\if :{?themis_app_password}
\else
    DO $$ BEGIN RAISE EXCEPTION 'The psql variable themis_app_password is not set; no password was changed (RR-65).'; END $$;
\endif

\if :{?themis_reporting_password}
\else
    DO $$ BEGIN RAISE EXCEPTION 'The psql variable themis_reporting_password is not set; no password was changed (RR-65).'; END $$;
\endif

SELECT format('ALTER ROLE themis_migrator PASSWORD %L', :'themis_migrator_password') \gexec
SELECT format('ALTER ROLE themis_app PASSWORD %L', :'themis_app_password') \gexec
SELECT format('ALTER ROLE themis_reporting PASSWORD %L', :'themis_reporting_password') \gexec
