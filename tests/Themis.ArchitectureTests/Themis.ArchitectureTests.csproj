<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture tests (D-26): fail the build on illegal references between the kernel, the modules and the host,
    and on layering violations inside each of them. The rules live in ThemisArchitectureRules.cs; every rule has
    a negative test against the fixtures in Fixtures/ so that a rule that stops catching violations fails too.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1812;CA1852;IDE0051;IDE0052;CA1822;CS0414;CA1823</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Host/Themis.Host/Themis.Host.csproj" />
  </ItemGroup>

</Project>
