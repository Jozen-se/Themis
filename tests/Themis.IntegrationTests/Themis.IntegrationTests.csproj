<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests run against a real PostgreSQL. By default Testcontainers starts one (Docker required).
    Set THEMIS_TEST_CONNECTION to a superuser connection string to use an existing server instead.
    The database role script is the same file Docker Compose applies: db/init/01-roles.sql.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../db/init/*.sql" Link="db/init/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
